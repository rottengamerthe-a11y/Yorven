# Discord Webhook URL (instant notifications in your private Discord #leads channel)
# Create in: Server Settings -> Integrations -> Webhooks -> New Webhook
VITE_DISCORD_WEBHOOK_URL=

# Web3Forms Access Key (free lead delivery to projects@yorven.in inbox)
# Generate your key in 10 seconds at: https://web3forms.com
VITE_WEB3FORMS_ACCESS_KEY=

# Optional custom / Vercel serverless endpoint
VITE_CONTACT_ENDPOINT=
